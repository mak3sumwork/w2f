{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://w2f.example/schemas/server-message.schema.json",
 "title": "W2F server -> client message (protocol 1)",
 "description": "Every WebSocket text frame the server sends is exactly one JSON object matching one branch of `oneOf`, told apart by its `type`. Additions within protocol 1 only ever ADD fields; a client must ignore fields it does not know (this schema lists them all, so it uses additionalProperties: false to keep itself honest). See docs/UE5-Integration.md.",
 "oneOf": [
  {
   "$ref": "#/$defs/welcome"
  },
  {
   "$ref": "#/$defs/lobby"
  },
  {
   "$ref": "#/$defs/catalog"
  },
  {
   "$ref": "#/$defs/match_started"
  },
  {
   "$ref": "#/$defs/phase"
  },
  {
   "$ref": "#/$defs/state"
  },
  {
   "$ref": "#/$defs/public_state"
  },
  {
   "$ref": "#/$defs/income"
  },
  {
   "$ref": "#/$defs/result"
  },
  {
   "$ref": "#/$defs/error"
  },
  {
   "$ref": "#/$defs/pong"
  },
  {
   "$ref": "#/$defs/pve_drop"
  },
  {
   "$ref": "#/$defs/gift_event"
  },
  {
   "$ref": "#/$defs/unit_event"
  },
  {
   "$ref": "#/$defs/combat_summary"
  },
  {
   "$ref": "#/$defs/combat"
  },
  {
   "$ref": "#/$defs/player_damaged"
  },
  {
   "$ref": "#/$defs/player_eliminated"
  },
  {
   "$ref": "#/$defs/match_over"
  },
  {
   "$ref": "#/$defs/bag_event"
  }
 ],
 "$defs": {
  "seat": {
   "type": "integer",
   "minimum": 0,
   "maximum": 7
  },
  "unit": {
   "type": "object",
   "properties": {
    "id": {
     "type": "integer",
     "minimum": 0
    },
    "champion": {
     "type": "integer",
     "minimum": 0
    },
    "star": {
     "type": "integer",
     "minimum": 1,
     "maximum": 3
    },
    "location": {
     "enum": [
      "bench",
      "board",
      "none"
     ],
     "description": "'none' only in a `bought` unit_event: a copy that merged the moment it arrived was never placed (x and y are -1)"
    },
    "x": {
     "type": "integer",
     "minimum": -1,
     "maximum": 8
    },
    "y": {
     "type": "integer",
     "minimum": -1,
     "maximum": 3
    },
    "items": {
     "type": "array",
     "items": {
      "type": "integer",
      "minimum": 0
     },
     "maxItems": 3
    }
   },
   "required": [
    "champion",
    "id",
    "items",
    "location",
    "star",
    "x",
    "y"
   ],
   "additionalProperties": false,
   "description": "A champion the player owns. Unit ids are unique for the whole match: (seat + 1) << 24 | serial."
  },
  "gift": {
   "type": "object",
   "properties": {
    "index": {
     "type": "integer",
     "minimum": 0,
     "maximum": 3
