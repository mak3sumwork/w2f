{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://w2f.example/schemas/client-command.schema.json",
 "title": "W2F client -> server command (protocol 1)",
 "description": "One JSON object per WebSocket text frame, at most 4096 bytes. Unknown actions / fields, missing fields, wrong types and out-of-range numbers are refused (see the `error` message).",
 "oneOf": [
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "buy_unit"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    },
    "shop_index": {
     "type": "integer",
     "minimum": 0,
     "maximum": 63
    }
   },
   "required": [
    "action",
    "shop_index"
   ],
   "additionalProperties": false
  },
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "reroll_shop"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    }
   },
   "required": [
    "action"
   ],
   "additionalProperties": false
  },
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "pick_gift"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    },
    "gift_index": {
     "type": "integer",
     "minimum": 0,
     "maximum": 3
    }
   },
   "required": [
    "action",
    "gift_index"
   ],
   "additionalProperties": false
  },
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "buy_xp"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    }
   },
   "required": [
    "action"
   ],
   "additionalProperties": false
  },
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "sell_unit"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    },
    "unit_id": {
     "type": "integer",
     "minimum": 0
    }
   },
   "required": [
    "action",
    "unit_id"
   ],
   "additionalProperties": false
  },
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "move_unit"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    },
    "unit_id": {
     "type": "integer",
     "minimum": 0
    },
    "location": {
     "enum": [
      "bench",
      "board"
     ]
    },
    "x": {
     "type": "integer",
     "minimum": 0,
     "maximum": 8
    },
    "y": {
     "type": "integer",
     "minimum": 0,
     "maximum": 3
    }
   },
   "required": [
    "action",
    "unit_id",
    "location",
    "x"
   ],
   "additionalProperties": false
  },
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "equip_item"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    },
    "unit_id": {
     "type": "integer",
     "minimum": 0
    },
    "item_id": {
     "type": "integer",
     "minimum": 1
    }
   },
   "required": [
    "action",
    "unit_id",
    "item_id"
   ],
   "additionalProperties": false
  },
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "unequip_item"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    },
    "unit_id": {
     "type": "integer",
     "minimum": 0
    },
    "slot": {
     "type": "integer",
     "minimum": 0,
     "maximum": 2
    }
   },
   "required": [
    "action",
    "unit_id",
    "slot"
   ],
   "additionalProperties": false
  },
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "get_state"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    }
   },
   "required": [
    "action"
   ],
   "additionalProperties": false
  },
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "get_fight"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    },
    "fight_index": {
     "type": "integer",
     "minimum": 0,
     "maximum": 7
    }
   },
   "required": [
    "action",
    "fight_index"
   ],
   "additionalProperties": false
  },
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "get_catalog"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    }
   },
   "required": [
    "action"
   ],
   "additionalProperties": false
  },
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "ping"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    }
   },
   "required": [
    "action"
   ],
   "additionalProperties": false
  },
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "combine_items"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    },
    "first": {
     "type": "integer",
     "minimum": 1,
     "description": "an item id in the item bag (a base component)"
    },
    "second": {
     "type": "integer",
     "minimum": 1,
     "description": "another base component in the bag (the same id twice needs two copies)"
    }
   },
   "required": [
    "action",
    "first",
    "second"
   ],
   "additionalProperties": false,
   "description": "combine two components of the bag into the finished item (recipes in items.json); answered with `result`, then a `bag_event` and the new `state`"
  },
  {
   "type": "object",
   "properties": {
    "action": {
     "const": "set_shop_lock"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    },
    "locked": {
     "type": "boolean"
    }
   },
   "required": [
    "action",
    "locked"
   ],
   "additionalProperties": false,
   "description": "(revision 3) lock or unlock the shop: a locked shop keeps its current offer through the next round's automatic refresh (rerolling and buying still work). Answered with `result` and the new `state`"
  },
  {
   "type": "object",
   "description": "(revision 5) answer the pending trait choice: an option index, or -1 to decline a prototype",
   "properties": {
    "action": {
     "const": "pick_trait_choice"
    },
    "id": {
     "type": "integer",
     "minimum": 0,
     "maximum": 9007199254740991,
     "description": "optional: echoed in the `result` / `error` answering this command"
    },
    "index": {
     "type": "integer",
     "minimum": -1,
     "maximum": 7
    }
   },
   "required": [
    "action",
    "index"
   ],
   "additionalProperties": false
  }
 ]
}
