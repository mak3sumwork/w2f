            "value": { "terms": [ { "source": "CastTargetAttackDamage", "percent": [-15, -20, -30] } ] } },
          { "type": "Status", "target": "CurrentTarget", "status": "BonusArmor", "permanent": true,
            "value": { "terms": [ { "source": "CastTargetArmor", "percent": [-15, -20, -30] } ] } }
