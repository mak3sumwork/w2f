// THE DESIGNER SPEC: the champion roster exactly as the design document gives it (frozen 2026-09-21, before the Phase A balance pass). The mechanics tests are
// written against these numbers so that retuning data/champions.json never breaks them; tests/tests.cpp also checks that data/champions.json still has
// the same champions, abilities and structure (only numbers may differ). Do not edit for balance: edit data/champions.json.
// W2F champion roster. Edited by the game designer; loaded by the server on start-up.
// Format: docs/champions-json.md.  Comments (// and /* */) are allowed in this file.
//
// Conventions
//   * Anything "per star" is either one number (same at every star) or exactly three: [1-star, 2-star, 3-star].
//   * Times can be written in seconds ("durationSeconds": 1.75) or ticks ("durationTicks": 52). The server
//     runs at 30 ticks/second; seconds are converted exactly and rounded half up (1.75 s = 52.5 -> 53 ticks).
//   * attackSpeed / manaRegen are decimals (attacks per second / mana per second).
//
// Values I had to assume because the design notes don't give them are marked ASSUMED.
{
  "version": 1,
  "champions": [

    // ---------------------------------------------------------------- ALESK (4-cost tank)
    {
      "id": 9001, "name": "Alesk", "cost": 4, "role": "Tank",
      "traits": ["Helios", "Bastion"],
      "stats": {
        "hp": [325, 475, 650], "armor": [31, 45, 63], "magicResist": [17, 24, 29], "attackDamage": [30, 35, 40],
        "attackSpeed": 1.0, "range": 1,
        "maxMana": 60, "manaRegen": 10.0     // 100-scale (was 6 and 1.0 on the old small scale: identical behaviour)
      },
      // Shield of 7/15/30% max HP for 1.75/2.0/2.25 s; while it holds, incoming damage is reduced by 5/12/25%.
      "ability": {
        "id": 1, "name": "AESA", "trigger": "Mana",
        "castLockTicks": 15,                                    // ASSUMED: 0.5 s cast animation
        "effects": [
          {
            "type": "Shield", "target": "Self",
            "amount": { "terms": [ { "source": "SelfMaxHp", "percent": [7, 15, 30] } ] },
            "durationSeconds": [1.75, 2.0, 2.25],
            "damageReductionPercent": [5, 12, 25]
          }
        ]
      },
      // Passive: +5/10/20% max HP, Armor and Magic Resist for the whole fight
      // (stand-in for "from items/buffs": a plain base-stat multiplier).
      "passive": {
        "id": 101, "name": "Helios Plating",
        "effects": [
          { "type": "Status", "target": "Self", "status": "MaxHp",       "percent": [5, 10, 20], "permanent": true },
          { "type": "Status", "target": "Self", "status": "Armor",       "percent": [5, 10, 20], "permanent": true },
          { "type": "Status", "target": "Self", "status": "MagicResist", "percent": [5, 10, 20], "permanent": true }
        ]
      }
    },

    // ---------------------------------------------------------------- BAIRA (3-cost marksman)
    {
      "id": 9002, "name": "Baira", "cost": 3, "role": "Damage",
      "traits": ["Selini", "Sorcerer"],                       // moved from Phaisa (Marksman) to Selini (Mage), September 2026
      "stats": {
        "hp": [600, 1080, 1944], "armor": 25, "magicResist": 25, "attackDamage": 30, "abilityDamage": 55,
        "attackSpeed": 0.70, "range": 4, "maxMana": 80, "startMana": 30,
        "projectileSpeed": 14
      },
      // Crashing Tide: 3 waves, 0.4 s apart, each on the largest cluster of enemies at that moment (it can move), 170/255/400 (+100% AP) magic damage
      // to every enemy within 1 hex. An enemy struck by a wave takes 25% more from the next one (a 0.5 s DamageTaken mark, applied a tick after each wave).
      "ability": {
        "id": 2, "name": "Crashing Tide", "trigger": "Mana", "castLockTicks": 15,
        "effects": [
          { "type": "Damage", "target": { "mode": "AreaAroundDensestEnemy", "radius": 1, "includeCenter": true }, "damageType": "Magic",
            "amount": { "flat": [170, 255, 400], "terms": [ { "source": "SelfAbilityDamage", "percent": 100 } ] },
            "repeat": { "count": 3, "everySeconds": 0.4 } },
          { "type": "Status", "target": { "mode": "AreaAroundDensestEnemy", "radius": 1, "includeCenter": true }, "status": "DamageTaken", "percent": 25,
            "durationSeconds": 0.5, "stacking": "refresh", "delayTicks": 1, "repeat": { "count": 3, "everySeconds": 0.4 } }
        ]
      }
    },

    // ---------------------------------------------------------------- CYLA (2-cost marksman)
    {
      "id": 9003, "name": "Cyla", "cost": 2, "role": "Damage",
      "traits": ["Hexagon", "Gunslinger"],
      "stats": {
        "hp": [650, 1170, 2106], "armor": 25, "magicResist": 25, "attackDamage": [50, 75, 113],
