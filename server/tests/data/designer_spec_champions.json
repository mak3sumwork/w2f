    // ---------------------------------------------------------------- NIHILA (5-cost Phaisa mage, The Void Empress)
    {
      "id": 9039, "name": "Nihila", "cost": 5, "role": "Damage",
      "traits": ["Phaisa", "Sorcerer"],
      "stats": { "hp": [1000, 1800, 3240], "armor": 45, "magicResist": 45, "attackDamage": 50, "abilityDamage": 90, "attackSpeed": 0.70, "range": 3, "maxMana": 180, "startMana": 80 },
      // Devour Reality: a 2 s channel (a stun or knock-up breaks it), then every enemy takes 400/650/5000 (+120% AP) magic damage and the ones left below
      // 20/25/50% of their max HP are executed (the engine caps an execute at 50%; at 3 stars the 5000 damage wipes the board anyway).
      "ability": {
        "id": 48, "name": "Devour Reality", "trigger": "Mana", "channelSeconds": 2,
        "effects": [
          { "type": "Damage", "target": "AllEnemies", "damageType": "Magic", "delaySeconds": 2,
            "amount": { "flat": [400, 650, 5000], "terms": [ { "source": "SelfAbilityDamage", "percent": 120 } ] } },
          { "type": "Status", "target": "AllEnemies", "status": "ExecuteBelow", "percent": [20, 25, 50], "durationTicks": 3, "delayTicks": 61 }
        ]
      },
      // Hunger of the Void: every enemy that dies while she stands gives her 8 Ability Power for the rest of the fight.
