// W2F Mother Nature: the free gifts that replace the shop every 3rd round (rounds 3, 6, 9 ... -- MatchConfig::motherNatureEveryRounds).
// Instead of a shop, each living player is shown `options` distinct gifts drawn from the tier in force this stage (weighted, no repeats)
// and takes exactly one for free. Format: docs/champions-json.md, section "mother_nature.json".
//
// * "tiers": a tier is used from its "fromStage" until a tier with a larger fromStage takes over. The first must start at stage 1. The ids
//   are the designer's numbers: there is no Tier 2 yet (the doc names Tier 1 early game and Tier 3 late game), add one by giving it a
//   fromStage between the two. The Tier 3 start (stage 4 = round 18) is ASSUMED.
// * gift "type": Gold / Xp / Heal (+"amount"), Item (+"itemClass" or an explicit "items" list), Unit (+"costs").
//   itemClass: Component = a base item that is an ingredient of a recipe (not the Omnilium Seed), Legendary = a finished item that grants no
//   trait, Emblem = a finished trait item, Any = every item in items.json.
// * "weight": relative chance among the tier's gifts (all weights below are ASSUMED; the design doc gives only the reward kinds).
// * A Unit gift is checked out of the shared champion pool while it is on offer (like a shop slot) and returns if it is not picked. If the
//   player has no room for it, they are paid gold equal to its cost instead.
// * Heal never takes a player above their starting health.
{
  "version": 1,
  "options": 2,
  "tiers": [

    // ---------------------------------------------------------------- TIER 1: early game
    {
      "id": 1, "name": "Early Game", "fromStage": 1,
      "gifts": [
        { "id": 101, "name": "Component",          "type": "Item", "itemClass": "Component", "weight": 25 },   // a random base item
        { "id": 102, "name": "Pocket Change",      "type": "Gold", "amount": 5,              "weight": 25 },
        { "id": 103, "name": "Growth",             "type": "Xp",   "amount": 4,              "weight": 20 },
        { "id": 104, "name": "Mother's Blessing",  "type": "Heal", "amount": 3,              "weight": 15 },   // +3 player HP
        { "id": 105, "name": "Wanderer",           "type": "Unit", "costs": [2, 3],          "weight": 15 }    // a random 2- or 3-cost champion
      ]
    },

    // ---------------------------------------------------------------- TIER 3: late game
    {
      "id": 3, "name": "Late Game", "fromStage": 4,
      "gifts": [
        { "id": 301, "name": "Legendary Item",     "type": "Item", "itemClass": "Legendary", "weight": 28 },   // a finished, non-emblem item
        { "id": 302, "name": "Emblem",             "type": "Item", "itemClass": "Emblem",    "weight": 6 },    // low chance
        { "id": 303, "name": "Bounty",             "type": "Gold", "amount": 15,             "weight": 28 },
        { "id": 304, "name": "Mother's Miracle",   "type": "Heal", "amount": 7,              "weight": 18 },   // +7 player HP
        { "id": 305, "name": "Champion of Legend", "type": "Unit", "costs": [5],              "weight": 20 }    // a 5-cost champion
      ]
    }

  ]
}
