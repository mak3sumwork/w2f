    "champion.9112.name": "Omnilium Protector",
    "champion.9112.desc": "A Nature plant that fights.",
    "champion.9112.trigger.69.name": "Grove Warden",
    "champion.9112.trigger.69.desc": "When a Nature ally dies, heals 54/97/175 Health and gains 80/100/250% Attack Speed for 3 s.",
    "champion.9112.ability.name": "Bulwark Roar",
    "champion.9112.ability.desc": "Gains a 300/450/800 (+100% AP) shield for 4 s and stuns the adjacent enemies for 1 s.",
    "trait.1.tagline": "The Sun's Wrath. Rally: each time your team loses another 25% of its Health, Helios units' mana bars get 10% shorter.",
    "trait.1.bp3": "Helios units gain 12 Armor and Magic Resist, and Rally.",
    "trait.1.bp5": "Helios units gain 35 Armor and Magic Resist, and Rally.",
    "trait.1.bp7": "Helios units gain 35 Armor and Magic Resist, and Rally. Each Rally smites every enemy for 15% of its max Health as true damage.",
    "trait.1.bp11": "Helios units gain 150 Armor and Magic Resist, and Rally. Each Rally smites every enemy for 15% of its max Health and executes the enemies left below 25% Health.",
    "trait.2.tagline": "The Void's Hunger. The strongest Phaisa units carry a mutation chosen by their class: Hyper-Adrenal (Assassin, Marksman, Duelist, Gunslinger: +15 Crit, 10% of damage as extra true damage), Chitinous Shell (Bastion, Protector: +250 Health, +30 Armor and Magic Resist), Caustic Spores (Sorcerer, Mystic: +20% AP, spells shred 15% Magic Resist) or Voidborn Siphon (everyone else: 12% Omnivamp). 7 different Phaisa units at level 10: the Phaisa Queen appears in your shop.",
    "trait.2.bp2": "Phaisa units gain 8% Attack Speed. 1 mutation.",
    "trait.2.bp4": "Phaisa units gain 18% Attack Speed. 2 mutations.",
    "trait.2.bp6": "Phaisa units gain 33% Attack Speed. 3 mutations. After 2 combats, you receive the Rift Herald.",
    "trait.2.bp9": "Phaisa units gain 40% Attack Speed. Every Phaisa unit is mutated and every mutation is supercharged (x2). Baron Nashor joins every combat.",
    "trait.3.tagline": "The Perfect Equation. Build an Invention on your right-most back hex: 8 s into combat it fires every module you chose.",
    "trait.3.bp2": "Choose a tier 1 module.",
    "trait.3.bp4": "Choose a tier 2 module (they stack).",
    "trait.3.bp6": "Choose a tier 3 module.",
    "trait.3.module.401.name": "Electrical Overload",
    "trait.3.module.401.desc": "Deals 100 true damage plus 8% of their max Health to every enemy.",
    "trait.3.module.402.name": "Blast Shield",
    "trait.3.module.402.desc": "Every ally gains a shield of 20% of its max Health for 6 s.",
    "trait.3.module.403.name": "90 Caliber Nets",
    "trait.3.module.403.desc": "Stuns the 3 enemies who have dealt the most damage for 2 s.",
    "trait.3.module.404.name": "E.M.P.",
    "trait.3.module.404.desc": "Every enemy loses 30 Mana.",
