    "trait.3.module.415.name": "Acceleration Gate",
    "trait.3.module.415.desc": "Hexagon units gain 10 Mana per second for 4 s.",
    "trait.3.module.421.name": "Mining Drill",
    "trait.3.module.421.desc": "Gain 4 gold after every combat.",
    "trait.3.module.422.name": "Superior Lifeform",
