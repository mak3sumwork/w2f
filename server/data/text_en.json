    "champion.9049.title": "The Greenmender",
    "champion.9049.ability.name": "Verdant Bloom",
    "champion.9049.ability.desc": "Heals the 3 lowest-Health allies for 115/170/255 (+75% AP).",
    "champion.9050.name": "Oakheart",
    "champion.9050.title": "The Rooted",
    "champion.9050.ability.name": "Uproot",
    "champion.9050.ability.desc": "Slams the ground: 165/250/375 (+8% max HP) magic damage to the enemies within 1 hex and a 1 s knock-up. Heals 15% of his max Health.",
    "champion.9051.name": "Willow",
    "champion.9051.title": "The Weeping",
    "champion.9051.ability.name": "Weeping Grove",
    "champion.9051.ability.desc": "Vines erupt under the largest group of enemies: 195/290/450 (+75% AP) magic damage within 1 hex and a 1.5 s root.",
    "champion.9052.name": "Sylva",
    "champion.9052.title": "The Starseed Ranger",
    "champion.9052.ability.name": "Starseed Volley",
    "champion.9052.ability.desc": "Fires 5 seed-arrows, each at a random enemy, for 110/170/450 (+45% AD) physical damage. They can critically strike.",
    "champion.9053.name": "Talon",
    "champion.9053.title": "The Wildclaw",
    "champion.9053.ability.name": "Pounce",
    "champion.9053.ability.desc": "Leaps next to the lowest-Health enemy and mauls it 3 times for 120/180/450 (+40% AD) physical damage each (they can critically strike), healing for 25% of the damage.",
    "champion.9054.name": "Yggra",
    "champion.9054.title": "The World Tree",
    "champion.9054.ability.name": "Heart of the Forest",
    "champion.9054.ability.desc": "Roots every enemy within 3 hexes for 1.5/2/5 s and deals 220/330/1500 (+75% AP) magic damage to them. Every ally, plants included, heals 20% of its max Health.",
    "champion.9041.name": "Rift Herald",
    "champion.9041.title": "The Void's Vanguard",
    "champion.9041.desc": "Given by Phaisa (6) after 2 combats. A 4-cost Phaisa / Bruiser that every 8 s charges down the line in front of it for 250 magic damage and a 1.25 s knock-up.",
    "champion.9041.passive.name": "Grows with the Rift",
