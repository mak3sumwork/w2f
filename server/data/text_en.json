    "trait.3.module.405.desc": "Allies gain 2 Mana per second and 20% Ability Power.",
    "trait.3.module.406.name": "Overclocked Capacitors",
    "trait.3.module.406.desc": "Allies gain 25% Attack Speed.",
    "trait.3.module.407.name": "Tuned Oscillator",
    "trait.3.module.407.desc": "Healing and shields on allies are 25% stronger.",
    "trait.3.module.411.name": "Magnetron Coil",
    "trait.3.module.411.desc": "Hexagon units gain 5% Damage Amp for every ability they have cast so far.",
