    "champion.9043.name": "Phaisa Queen",
    "champion.9043.title": "Mother of the Void",
    "champion.9043.desc": "Offered in the shop (7 gold) to a player with 7 different Phaisa units on the board at level 10. Takes 2 board slots. Her attacks splash 30% physical damage to the enemies next to her target.",
    "champion.9043.passive.name": "Sovereign",
    "champion.9043.passive.desc": "Immune to crowd control.",
    "champion.9043.ability.name": "Void Torrent",
