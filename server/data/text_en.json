    "champion.9048.title": "The Thornblade",
    "champion.9048.ability.name": "Thornwhirl",
    "champion.9048.ability.desc": "Spins, dealing 105/160/240 (+60% AD) physical damage to the adjacent enemies, who bleed for 70/105/150 over 3 s.",
