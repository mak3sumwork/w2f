        "id": 11, "name": "Lunar Blessing", "trigger": "Mana",
        "castLockTicks": 15,                                                    // ASSUMED: 0.5 s cast animation
        "effects": [
          { "type": "Heal", "target": "LowestHpAlly", "amount": [200, 300, 500] },
          { "type": "Damage", "target": { "mode": "HighestHpEnemyNearTarget", "radius": 2 },
