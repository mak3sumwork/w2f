// W2F champion roster. Edited by the game designer; loaded by the server on start-up.
// Format: docs/champions-json.md.  Comments (// and /* */) are allowed in this file.
//
// Conventions
//   * Anything "per star" is either one number (same at every star) or exactly three: [1-star, 2-star, 3-star].
//   * Times can be written in seconds ("durationSeconds": 1.75) or ticks ("durationTicks": 52). The server
//     runs at 30 ticks/second; seconds are converted exactly and rounded half up (1.75 s = 52.5 -> 53 ticks).
//   * attackSpeed / manaRegen are decimals (attacks per second / mana per second).
//
// Values I had to assume because the design notes don't give them are marked ASSUMED.
{
  "version": 1,
  "champions": [

    // ---------------------------------------------------------------- ALESK (4-cost tank)
    {
      "id": 9001, "name": "Alesk", "cost": 4, "role": "Tank",
      "traits": ["Helios"],
      "stats": {
        "hp": [325, 475, 650], "armor": [31, 45, 63], "magicResist": [17, 24, 29], "attackDamage": [30, 35, 40],
        "attackSpeed": 1.0, "range": 1,
        "maxMana": 60, "manaRegen": 10.0     // 100-scale (was 6 and 1.0 on the old small scale: identical behaviour)
      },
      // Shield of 7/15/30% max HP for 1.75/2.0/2.25 s; while it holds, incoming damage is reduced by 5/12/25%.
      "ability": {
        "id": 1, "name": "AESA", "trigger": "Mana",
        "castLockTicks": 15,                                    // ASSUMED: 0.5 s cast animation
        "effects": [
          {
            "type": "Shield", "target": "Self",
            "amount": { "terms": [ { "source": "SelfMaxHp", "percent": [7, 15, 30] } ] },
            "durationSeconds": [1.75, 2.0, 2.25],
            "damageReductionPercent": [5, 12, 25]
          }
        ]
      },
      // Passive: +5/10/20% max HP, Armor and Magic Resist for the whole fight
      // (stand-in for "from items/buffs": a plain base-stat multiplier).
      "passive": {
        "id": 101, "name": "Helios Plating",
        "effects": [
          { "type": "Status", "target": "Self", "status": "MaxHp",       "percent": [5, 10, 20], "permanent": true },
          { "type": "Status", "target": "Self", "status": "Armor",       "percent": [5, 10, 20], "permanent": true },
          { "type": "Status", "target": "Self", "status": "MagicResist", "percent": [5, 10, 20], "permanent": true }
        ]
      }
    },

    // ---------------------------------------------------------------- BAIRA (3-cost marksman)
    {
      "id": 9002, "name": "Baira", "cost": 3, "role": "Damage",
      "traits": ["Phaisa"],
      "stats": {
        "hp": [100, 150, 200], "armor": [10, 15, 20], "magicResist": [5, 9, 13], "attackDamage": [20, 25, 29],
        "abilityDamage": [15, 21, 40],            // the sheet's "AP"
        "attackSpeed": 0.5, "range": 4            // range ASSUMED (marksman)
        // no maxMana: Baira does not use mana
      },
      // Every 5th attack (the count restarts when she changes target or her target dies):
      //   * burns everything within 3 hexes of her target for 15/21/36 TOTAL over 2.5/2.0/1.75 s. The total scales with her
      //     AP (abilityDamage 15/21/40, x abilityPowerPercent): 100% / 100% / 90% of it = 15 / 21 / 36. Stacks:
      //     a burn landing on a running one deals more (+25/35/45% -- ASSUMED, carried over from the earlier design);
      //   * grants her +20/25/35% attack speed for 5 s.
      "ability": {
        "id": 2, "name": "Ardeat's Destiny", "trigger": "EveryNthAttack", "attackCount": 5, "resetOnTargetChange": true,
        "effects": [
          {
            "type": "DoT", "target": { "mode": "AreaAroundTarget", "radius": 3, "includeCenter": true },
            "damageType": "Magic",
            "amount": { "terms": [ { "source": "SelfAbilityDamage", "percent": [100, 100, 90] } ] }, "amountIsTotal": true,
            "durationSeconds": [2.5, 2.0, 1.75], "intervalSeconds": 0.5,   // interval ASSUMED: a hit every 0.5 s
            "stackBonusPercent": [25, 35, 45]
          },
          { "type": "Status", "target": "Self", "status": "AttackSpeed", "percent": [20, 25, 35], "durationSeconds": 5 }
        ]
      },
      // Passive "Wound": her burns also reduce their victims' healing by 30% for as long as they burn.
      // (There is no healing in the game yet; the status is applied and shown, and will bite once healing exists.)
      "passive": {
        "id": 102, "name": "Wound",
        "effects": [ { "type": "Status", "target": "Self", "status": "InflictsWound", "percent": 30, "permanent": true } ]
      }
    },

