    // ---------------------------------------------------------------- VEGA (5-cost mage) [Najmi]
    {
      "id": 9012, "name": "Vega", "cost": 5, "role": "Damage",
      "traits": ["Najmi"],
      "stats": {
        "hp": [850, 1530, 2754], "armor": 35, "magicResist": 35, "attackDamage": 40, "abilityDamage": [80, 120, 180],
        "attackSpeed": 0.75, "range": 4, "maxMana": 100
      },
      // Channels for 4 s. Every 0.5 s (8 pulses) she hits a random enemy for 100/150/400 magic damage. If the channel is
      // not interrupted (stun / knock-up / death), it ends with 500/800/2000 magic damage to the whole enemy board.
      "ability": {
        "id": 12, "name": "Starfall Channel", "trigger": "Mana", "channelSeconds": 4,
        "effects": [
          { "type": "Damage", "target": "RandomEnemy", "damageType": "Magic", "amount": [100, 150, 400],
            "delaySeconds": 0.5, "repeat": { "count": 8, "everySeconds": 0.5 } },
          { "type": "Damage", "target": { "mode": "AreaAroundSelf", "radius": 15, "includeCenter": false, "side": "Enemies" },
            "damageType": "Magic", "amount": [500, 800, 2000], "delaySeconds": 4 }
        ]
      }
    }

  ]
}
