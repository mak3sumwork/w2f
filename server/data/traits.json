// W2F traits and synergies. Loaded next to champions.json; every trait tag a champion lists must be declared here.
// Format: docs/champions-json.md (section "traits.json").
//
// At the start of a fight the server counts, for each team, how many DIFFERENT champions (two copies of one champion
// count once) on the board have each trait, and applies the highest breakpoint reached -- before passives fire.
//   "scope": "AllAllies"    -> every unit on the team gets the effect
//   "scope": "TraitHolders" -> only units that themselves have this trait get it
// Statuses of one type add up, so a unit that gets both a "AllAllies +10%" and a "TraitHolders +10%" has +20%.
//   "scope": "Team"         -> applied ONCE for the whole team (cast by its lowest-id holder), aimed by the effect's own "target"
//                              ("Self" by default; "AllEnemies" / "AllAllies" to change a whole side, e.g. the Coregons zone)
// A breakpoint may also hand hooks ("triggers") to its units. See docs/champions-json.md and docs/content-notes.md.
//
// TRAIT SYSTEM v2 (September 2026, W2F_GameDesignDocument.md section 2B). Every champion has an ORIGIN (Helios, Selini, Phaisa, Coregons, Hexagon,
// Najmi, Nature, Omnilium) and one or two CLASSES (Bastion, Bruiser, Sorcerer, Marksman, Mystic, Duelist, Assassin, Gunslinger, Protector). The
// match-level keys ("paths", "xpAfterCombat", "takedownsPerGold", "starDust", "grantUnit", "plants", "moduleTier", "queen") are read by the MatchManager;
// the rest acts inside fights. Triggers with scope "Team" fire once per team (OnTeamHpLoss only).
{
  "version": 1,
  "traits": [

    // ================================ ORIGINS ================================

    // HELIOS (3/5/7/11) "The Sun's Wrath": Helios units gain 12 / 35 / 35 / 150 Armor and Magic Resist. RALLY: each time the team has lost another quarter
    // of its total max HP (below 75, 50 and 25 percent), every Helios unit's mana bar gets 10 percent shorter. (7): each Rally also smites every enemy for 15
    // percent of its max HP as true damage. (11): each Rally also executes the enemies left below 25 percent of their max HP. (Aureon's own trigger: +30 mana.)
    {
      "id": 1, "name": "Helios",
      "breakpoints": [
        { "count": 3, "effects": [ { "scope": "TraitHolders", "type": "Status", "status": "BonusArmor", "value": 12, "permanent": true }, { "scope": "TraitHolders", "type": "Status", "status": "BonusMagicResist", "value": 12, "permanent": true } ], "triggers": [ { "scope": "TraitHolders", "ability": { "id": 261, "name": "Rally", "trigger": "OnTeamHpLoss", "thresholdPercent": 25, "maxTriggers": 3,
            "effects": [ { "type": "Status", "target": "Self", "status": "ManaCost", "percent": -10, "permanent": true } ] } } ] },
        { "count": 5, "effects": [ { "scope": "TraitHolders", "type": "Status", "status": "BonusArmor", "value": 35, "permanent": true }, { "scope": "TraitHolders", "type": "Status", "status": "BonusMagicResist", "value": 35, "permanent": true } ], "triggers": [ { "scope": "TraitHolders", "ability": { "id": 261, "name": "Rally", "trigger": "OnTeamHpLoss", "thresholdPercent": 25, "maxTriggers": 3,
            "effects": [ { "type": "Status", "target": "Self", "status": "ManaCost", "percent": -10, "permanent": true } ] } } ] },
        { "count": 7, "effects": [ { "scope": "TraitHolders", "type": "Status", "status": "BonusArmor", "value": 35, "permanent": true }, { "scope": "TraitHolders", "type": "Status", "status": "BonusMagicResist", "value": 35, "permanent": true } ], "triggers": [ { "scope": "TraitHolders", "ability": { "id": 261, "name": "Rally", "trigger": "OnTeamHpLoss", "thresholdPercent": 25, "maxTriggers": 3,
            "effects": [ { "type": "Status", "target": "Self", "status": "ManaCost", "percent": -10, "permanent": true } ] } }, { "scope": "Team", "ability": { "id": 262, "name": "Solar Smite", "trigger": "OnTeamHpLoss", "thresholdPercent": 25, "maxTriggers": 3,
            "effects": [ { "type": "Damage", "target": "AllEnemies", "damageType": "True", "amount": { "terms": [ { "source": "TargetMaxHp", "percent": 15 } ] } } ] } } ] },
        { "count": 11, "effects": [ { "scope": "TraitHolders", "type": "Status", "status": "BonusArmor", "value": 150, "permanent": true }, { "scope": "TraitHolders", "type": "Status", "status": "BonusMagicResist", "value": 150, "permanent": true } ], "triggers": [ { "scope": "TraitHolders", "ability": { "id": 261, "name": "Rally", "trigger": "OnTeamHpLoss", "thresholdPercent": 25, "maxTriggers": 3,
            "effects": [ { "type": "Status", "target": "Self", "status": "ManaCost", "percent": -10, "permanent": true } ] } }, { "scope": "Team", "ability": { "id": 262, "name": "Solar Smite", "trigger": "OnTeamHpLoss", "thresholdPercent": 25, "maxTriggers": 3,
            "effects": [ { "type": "Damage", "target": "AllEnemies", "damageType": "True", "amount": { "terms": [ { "source": "TargetMaxHp", "percent": 15 } ] } } ] } }, { "scope": "Team", "ability": { "id": 263, "name": "Judgment of the Sun", "trigger": "OnTeamHpLoss", "thresholdPercent": 25, "maxTriggers": 3,
